{
  "name": "agentc",
  "version": "0.1.0",
  "description": "Define coding agents once, install them natively into Claude Code, OpenCode, pi and oh-my-pi.",
  "type": "module",
  "bin": {
    "agentc": "./src/cli.ts"
  },
  "scripts": {
    "agentc": "bun run src/cli.ts",
